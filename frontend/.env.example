# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These are public identifiers, not secrets; access is enforced by security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Raspberry Pi FastAPI backend ───────────────────────────────────────────────
# IP or hostname of the Pi running uvicorn pi_api:app --host 0.0.0.0 --port 8000
# Use the Tailscale IP (e.g. 100.64.x.x) for remote access, or LAN IP locally.
VITE_PI_HOST=
VITE_PI_PORT=8000

# Optional fallback camera URL if /rover/camera/streamUrl is not set in RTDB.
# Leave empty — the Pi stream (http://<VITE_PI_HOST>:8000/stream) is used by default.
VITE_CAMERA_STREAM_URL=

# Always use the backend proxy (recommended when the dashboard is served over HTTPS).
VITE_FORCE_CAMERA_PROXY=false

# Set to false once the companion device or backend writes events to Firestore.
VITE_FRONTEND_EVENT_LOGGING=true
