rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Event log: any signed-in user can read; only well-formed appends allowed.
    match /events/{eventId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['type', 'label', 'confidence', 'message', 'timestamp', 'clientTs', 'source', 'createdBy'])
        && request.resource.data.type in ['gas', 'flame', 'detection']
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 64
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 256
        && (request.resource.data.confidence == null
            || (request.resource.data.confidence is number
                && request.resource.data.confidence >= 0
                && request.resource.data.confidence <= 1))
        && request.resource.data.timestamp == request.time
        && request.resource.data.clientTs is int
        && request.resource.data.createdBy == request.auth.uid;

      // Events are an append-only audit trail.
      allow update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
