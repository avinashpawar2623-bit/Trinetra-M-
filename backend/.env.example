PORT=3001

# Rover MJPEG stream proxied at /api/camera/stream
CAMERA_STREAM_URL=http://192.168.1.50:81/stream
CAMERA_CONNECT_TIMEOUT_MS=5000

# Set to "production" to serve frontend/dist with SPA fallback
NODE_ENV=development
# FRONTEND_DIST=../../frontend/dist

# Pi FastAPI base used by the admin command gateway. Not a browser secret.
# Bind the Pi control port so it is reachable from this server only.
PI_BASE_URL=https://vsit.tail13799b.ts.net
COMMAND_TIMEOUT_MS=350

# Require a Firebase ID token on the camera proxy once Admin credentials exist.
CAMERA_PROXY_REQUIRE_AUTH=false

# One of these is required before /api/control will accept tokens.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
